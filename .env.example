# Server-only Supabase credentials. Never expose the service-role key to the browser.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Translation for written observations is optional. The default provider is
# MyMemory, which sends the public observation text to its API and has a small
# free quota. Set TRANSLATION_PROVIDER=libretranslate to use your own instance.
# TRANSLATION_PROVIDER="mymemory"
# LIBRETRANSLATE_URL="https://your-libretranslate-instance"
# LIBRETRANSLATE_API_KEY=""

# WisprFlow API key for transcription
WISPRFLOW_API_KEY="your-wisprflow-api-key"